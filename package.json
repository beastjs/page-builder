{
  "name": "@beastjs/page-builder",
  "version": "0.1.0",
  "description": "A floating page builder for Beast development servers.",
  "type": "module",
  "license": "ISC",
  "main": "./dist/vite.js",
  "types": "./dist/vite.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.ts",
      "default": "./dist/rsbuild.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "bun run build && vite --config playground/vite.config.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test",
    "test:browser": "playwright test",
    "check": "bun run typecheck && bun run test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "beast-tsrx": "0.4.3",
    "octane": "0.4.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "vite": "^8.0.16",
    "@rspack/core": "^2.0.0",
    "@rsbuild/core": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@octanejs/tanstack-router": "0.1.57",
    "@playwright/test": "^1.56.0",
    "@rsbuild/core": "^2.2.9",
    "@rspack/core": "^2.2.7",
    "@rspack/dev-server": "^2.2.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "vite": "^8.0.16"
  }
}
