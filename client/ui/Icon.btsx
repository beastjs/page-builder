import { icons } from '../icons.js'

props { name }: { name: string }

svg(
  ~ viewBox="0 0 24 24"
  ~ fill="none"
  ~ stroke="currentColor"
  ~ stroke-width="1.5"
  ~ stroke-linecap="round"
  ~ stroke-linejoin="round"
  ~ aria-hidden="true"
  ~ dangerouslySetInnerHTML={{ __html: icons[name] ?? icons.hex }}
  ~ )
