import type { SuccessScreen } from './types.js'
import ViewHeader from '../ui/ViewHeader.btsx'
import Icon from '../ui/Icon.btsx'

props { screen, onBack, onClose }: { screen: SuccessScreen; onBack: () => void; onClose: () => void }
setup
  const title = screen.type === 'tabs-success' ? (screen.editing ? 'Tabs updated' : 'Tabs added') : screen.type === 'section-success' ? 'Section added' : screen.section ? 'Section updated' : screen.editing ? 'Page updated' : 'Your idea has a home'

ViewHeader(title={title} subtitle={screen.preview.path} onBack={onBack} onClose={onClose})
.success-body
  .success-icon
    Icon(name="check")
  if screen.type === 'tabs-success'
    fragment
      h2 Your tabs are ready.
      p
        | #{`${screen.count} tabs ${screen.editing ? 'updated on' : 'added to'} `}
        strong #{screen.preview.routePath}
        | .
  elseif screen.type === 'section-success'
    fragment
      span.eyebrow READY FOR WHAT’S NEXT
      h2 #{screen.label} is on the page.
      p
        | #{`${screen.preview.name} is in ${screen.preview.path} and renders on ${screen.preview.page}.`}
        if !screen.preview.routePath
          fragment
            br
            | No route renders that page yet, so the section isn’t visible.
      if screen.preview.routePath
        a.primary.visit(href={screen.href} onClick={screen.onVisit})
          | Open page
          Icon(name="arrow")
      button.secondary.add-another(type="button" onClick={screen.onAddAnother}) Add another section
  else
    fragment
      span.eyebrow READY FOR WHAT’S NEXT
      h2 #{screen.section ? `#${screen.section}` : screen.name} is #{screen.editing ? 'updated' : 'created'}.
      p
        | #{screen.section ? 'Your section changes are saved.' : screen.editing ? 'Your page changes are saved.' : 'Your route and navigation link are ready.'}
        if screen.preview.routePath
          fragment
            br
            | #{'Find it at '}
            strong #{screen.preview.routePath}
            | .
      if screen.preview.routePath
        a.primary.visit(href={screen.href} onClick={screen.onVisit})
          | Open page
          Icon(name="arrow")
      button.secondary.edit-saved-page(type="button" onClick={screen.onEdit}) #{screen.section ? 'Edit section' : 'Edit page'}
  button.secondary.done(type="button" onClick={screen.onDone})
    | Back to builder
    Icon(name="arrow")
