import type { FileInspectorProps } from './types.js'
import ViewHeader from '../ui/ViewHeader.btsx'
import SourceViewer from '../ui/SourceViewer.btsx'
import StatusMessage from '../ui/StatusMessage.btsx'
import ThemeToggle from '../ui/ThemeToggle.btsx'

props { file, source, instances, message, dark, onCopy, onEditPage, onEditTabs, onBack, onClose }: FileInspectorProps

ViewHeader(title={file.name} subtitle={file.path} onBack={onBack} onClose={onClose})
.preview-body
  if instances.length
    .existing-tabs
      h3 Tabs on this page
      each instance in instances key instance.id
        if instance.draft
          button.secondary(type="button" data-edit-tabs={instance.id} onClick={() => onEditTabs(instance)}) Edit tabs · #{instance.draft.label || 'Tabs'} · Line #{instance.line}
        else
          p.hint Line #{instance.line}: #{instance.reason ?? 'Edit these tabs in the page source.'}
  if file.error
    p.error-note #{file.error}
  SourceViewer(source={source} label={`Source ${file.path}`})
  StatusMessage(message={message})
footer.action-footer
  span #{file.lines} lines · #{file.components.length} component#{file.components.length === 1 ? '' : 's'}
  .file-actions
    button.secondary.copy(type="button" onClick={() => void onCopy()}) Copy source
    if file.kind === 'page'
      button.primary.edit-page(type="button" onClick={onEditPage}) Edit page
  ThemeToggle(dark={dark})
