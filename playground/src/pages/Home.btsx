import PageTabs from "../components/Tabs.btsx"
import ProjectCard from '../components/ProjectCard.btsx'
import SectionTabs from '../components/SectionTabs.btsx'
import Footer from '../sections/Footer.btsx'
import Features from '../sections/Features.btsx'

div.home#hero
  PageTabs(items={[{"href":"#account","id":"account","label":"Accounts","shortLabel":"Account","icon":"arrow-right"},{"href":"#projects","id":"projects","label":"Projects","shortLabel":"Projects","icon":"close"},{"href":"#tab-3","id":"tab-3","label":"Kimpoi","shortLabel":"Kimpoi","icon":"menu"}]} activeId={"account"} label={"The tabs"})
  section.intro
    p.eyebrow YOUR WORKSPACE, REIMAGINATED
    h1 A space for your
      br
      | next big thing.
    p.description Every great page starts with an idea. Bring yours to life with Beast, one component at a time.
    div.shortcut-note
      span.sonar-dot
      | Your page builder is a shortcut away.
      kbd ⌘ B
  SectionTabs
  section.projects#features
    div.section-heading
      h2 A few starting points
      span 03 / IDEAS
    div.project-grid
      ProjectCard(number="01" title="The everyday" description="A quiet home for the things you’re making." kind="Portfolio")
      ProjectCard(number="02" title="Something new" description="Give your next big idea its own little corner." kind="Landing page")
      ProjectCard(number="03" title="In good company" description="Bring people, projects, and possibilities together." kind="Dashboard")
  Features
  footer.workspace-footer#footer
    span Built with Beast. Made by you.
    span A LITTLE STRUCTURE. A LOT OF POSSIBILITY.
  Footer
