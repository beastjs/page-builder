import PageTabs from '../../../src/ui/Tabs.btsx'
import type { IconName } from '../../../src/lib/icons'

module
  export interface TabItem {
    href: string
    id: string
    label: string
    shortLabel: string
    icon: IconName
  }

props { activeId, items, label = 'Tabs' }: { activeId: string; items: readonly TabItem[]; label?: string }

div.page-tabs
  PageTabs(activeId={activeId} items={items} label={label})

style
  .page-tabs { margin-bottom: 36px; }
